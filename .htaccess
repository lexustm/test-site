DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType image/webp .webp

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^vibelink\.ru$ [NC]
  RewriteRule ^ https://vibelink.ru%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://vibelink.ru/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net 'sha256-jtdFfiCZaUoyx4BEGkHlx9Kjf85IFdY1TDBgdgbP+ks=' 'sha256-R2QK6NVkZG64f9EELnwxHU1OPuEHziLrZDUdxKWJ7TU=' 'sha256-lB590v+0zaiQdK0AKCF+scgf3Az84qmkPS1087noGVc=' 'sha256-RT8fkZH4DadXD7mArYMIi+HbdxYAaWL1cuc5oDEh4fI=' 'sha256-ZzjEGviIID9d2eKVCXMcxzTeP015vwHYIa5Ev36UOkg=' 'sha256-AZe6VQnmUl5g1gcPZ827bQ1KL0DdAB1gXABtPMNby6I=' 'sha256-J3lfwZXc17Ctj0f7MhHl6dZsOf5vfWICWTqTIlXRUe0=' 'sha256-x6Pv8V0N4HFeUzXptad0aAPpZs3pgOAgs1FfP/cCj9w=' 'sha256-JZaIFcyNv6rzYgYt69pf4NNWHLYK5GcJD1viUyV4E+4=' 'sha256-CZpQKZx6S31GcpW3h10m/BVnBWeOtyfHIA2eV9chxtQ=' 'sha256-zGcG7wf1uK4NZoyU5rbxazD8KDDjFw0L0/dmfAM4l+U=' 'sha256-MkZk8DqqeWGtW57LHPAsx75MHeDOZephTl7sT64g+Nc=' 'sha256-kF0N94uTVwzrOYJOCGq7ZHQaiDh+riwLqCVcAvDA7hw=' 'sha256-wrHOsZ171eTlS3AE17yhulXfhzEFk4MgnsYzPivxAaY=' 'sha256-eRXMHVpaL7Qvok6zwt2r+v4UpUjtisDHTyCnqXx0EZY=' 'sha256-aT48uFvnYrE9J7IcK2fWaRXwyfZZu49JXj3JwXRhFvE=' 'sha256-lpiDgCakI+YBlfn4FAhXgE5sRqhK8wZapFFgjqpgU/w='; style-src-elem 'self' https://fonts.googleapis.com 'sha256-fNDLA8opLTco2pk2o4AgsgQPEmO+lYrtiI/PPRDlW2A='; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.org https://mc.webvisor.com; connect-src https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.org https://mc.webvisor.com wss://mc.yandex.ru wss://mc.yandex.com wss://mc.webvisor.org wss://mc.webvisor.com; child-src blob: https://mc.yandex.ru https://mc.yandex.com; frame-src blob: https://mc.yandex.ru https://mc.yandex.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https://metrika.yandex.ru https://analytics.yandex.ru https://metr.yandex.ru https://metrica.yandex.ru https://metrika.ya.ru https://metrica.ya.ru; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

<IfModule mod_filter.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
